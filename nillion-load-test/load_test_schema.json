{
  "_id": "",
  "type": "standard",
  "name": "Monadic DNA Load Test",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "uniqueItems": true,
    "items": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "format": "uuid",
          "coerce": true
        },
        "user_id": {
          "type": "string"
        },
        "profile_name": {
          "type": "string"
        },
        "rsid": {
          "type": "string"
        },
        "genotype": {
          "type": "string"
        }
      },
      "required": [
        "_id",
        "user_id",
        "rsid",
        "genotype"
      ],
      "additionalProperties": false
    }
  }
}
